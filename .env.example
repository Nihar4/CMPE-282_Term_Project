# ============================================================
# Enterprise Knowledge Portal - Environment Variables
# This file is safe to commit to GitHub — NO real credentials.
# Copy to .env and fill in your actual values.
# ============================================================

# ─── Application ──────────────────────────────────────────────────────────────
JWT_SECRET=your-strong-random-jwt-secret-min-32-chars
DEV_MODE=true

# ─── Okta SSO ────────────────────────────────────────────────────────────────
OKTA_DOMAIN=your-okta-domain.okta.com
OKTA_ISSUER=https://your-okta-domain.okta.com/oauth2/default
OKTA_CLIENT_ID=your-okta-client-id
OKTA_CLIENT_SECRET=your-okta-client-secret
OKTA_REDIRECT_URI=http://localhost:3000/authorization-code/callback
OKTA_LOGOUT_REDIRECT_URI=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enterprise_portal
DB_USER=portal_user
DB_PASSWORD=your-db-password

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=localhost:6379

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
AI_REQUESTS_TOPIC=portal.ai.requests
NOTIFICATIONS_TOPIC=portal.notifications
AI_CONSUMER_GROUP=portal-ai-workers
NOTIFICATION_CONSUMER_GROUP=portal-notification-service
AI_WORKER_ENABLED=true

# ─── NVIDIA AI API ────────────────────────────────────────────────────────────
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-120b

# ─── GCP ──────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
GCS_BUCKET=enterprise-portal-files

# ─── React API URL ─────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8080

# ─── Internal service URLs (docker-compose) ───────────────────────────────────
AUTH_SERVICE_URL=http://localhost:8081
DATA_SERVICE_URL=http://localhost:8082
FILE_SERVICE_URL=http://localhost:8083
AI_SERVICE_URL=http://localhost:8084
ANALYTICS_SERVICE_URL=http://localhost:8085
