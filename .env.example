# ============================================================
# Enterprise Knowledge Portal - Environment Variables
# This file is safe to commit to GitHub — NO real credentials.
# Copy to .env and fill in your actual values.
# ============================================================

# ─── Application ──────────────────────────────────────────────────────────────
JWT_SECRET=your-strong-random-jwt-secret-min-32-chars
DEV_MODE=true

# ─── Auth0 SSO ────────────────────────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# React frontend
REACT_APP_AUTH0_DOMAIN=your-tenant.us.auth0.com
REACT_APP_AUTH0_CLIENT_ID=your-auth0-client-id

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enterprise_portal
DB_USER=portal_user
DB_PASSWORD=your-db-password

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=localhost:6379

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ─── NVIDIA AI API ────────────────────────────────────────────────────────────
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=moonshotai/kimi-k2-instruct

# ─── GCP ──────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
GCS_BUCKET=enterprise-portal-files
GKE_CLUSTER_NAME=enterprise-portal-cluster

# ─── React API URL ─────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8080

# ─── Internal service URLs (docker-compose) ───────────────────────────────────
AUTH_SERVICE_URL=http://localhost:8081
DATA_SERVICE_URL=http://localhost:8082
FILE_SERVICE_URL=http://localhost:8083
AI_SERVICE_URL=http://localhost:8084
ANALYTICS_SERVICE_URL=http://localhost:8085
