# Copy to terraform.tfvars and fill in values
# terraform.tfvars is gitignored — never commit real values

project_id      = "your-gcp-project-id"
region          = "us-central1"
zone            = "us-central1-a"
db_tier         = "db-g1-small"
db_name         = "enterprise_portal"
db_user         = "portal_user"
db_password     = "CHANGE_THIS_STRONG_PASSWORD"
gcs_bucket_name = "enterprise-portal-files"
environment     = "production"
deploy_serverless = true
kafka_brokers     = "REPLACE_WITH_MANAGED_KAFKA_BOOTSTRAP:9092"
